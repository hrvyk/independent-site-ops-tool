# Copy to your shell env before starting shipping_quote_proxy.js

# ---- Server ----
SHIP_PROXY_HOST=127.0.0.1
SHIP_PROXY_PORT=8787

# ---- DHL ----
# DHL_API_KEY=your_dhl_api_key
# DHL_ACCOUNT_NUMBER=your_dhl_account_number
# DHL_BASE_URL_SANDBOX=https://api-mock.dhl.com/mydhlapi
# DHL_BASE_URL_PROD=https://express.api.dhl.com/mydhlapi

# ---- UPS ----
# UPS_CLIENT_ID=your_ups_client_id
# UPS_CLIENT_SECRET=your_ups_client_secret
# UPS_ACCOUNT_NUMBER=your_ups_account_number
# UPS_BASE_URL_SANDBOX=https://wwwcie.ups.com
# UPS_BASE_URL_PROD=https://onlinetools.ups.com
# UPS_TOKEN_PATH=/security/v1/oauth/token
# UPS_RATE_PATH=/api/rating/v2409/Rate

# ---- FedEx ----
# FEDEX_CLIENT_ID=your_fedex_client_id
# FEDEX_CLIENT_SECRET=your_fedex_client_secret
# FEDEX_ACCOUNT_NUMBER=your_fedex_account_number
# FEDEX_BASE_URL_SANDBOX=https://apis-sandbox.fedex.com
# FEDEX_BASE_URL_PROD=https://apis.fedex.com

# ---- Air / Sea fallback (if no freight API yet) ----
# AIR_FLAT_RATE_USD=95
# AIR_TRANSIT_DAYS=9
# SEA_FLAT_RATE_USD=42
# SEA_TRANSIT_DAYS=32

# ---- Or custom endpoints ----
# AIR_RATE_ENDPOINT=https://your-forwarder-api/air/quote
# SEA_RATE_ENDPOINT=https://your-forwarder-api/sea/quote
